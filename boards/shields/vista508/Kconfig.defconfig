if SHIELD_VISTA508

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config LV_Z_MEM_POOL_SIZE
    default 4096 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_FONT_MONTSERRAT_16
    select LV_USE_IMG
    select LV_USE_CANVAS

config VISTA508_WIDGET_INVERTED
    bool "Invert custom status widget colors"

config VISTA508_MESSAGE_DISPLAY_MS
    int "General Message Display Duration (ms)"
    default 5000

config VISTA508_SETTINGS_LAYER
    int "Layer index of the settings layer, display setting change notifications are shown while it is active"
    default -1

config VISTA508_CHARGE_FULL_PCT
    int "Battery level treated as fully charged"
    range 1 100
    default 95
    help
      Charging is inferred as USB powered and below this level.
      Voltage based state of charge reads high while charging, so 100 may never be reached.

if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_FONT_MONTSERRAT_18
    select LV_USE_ANIMIMG
    select ZMK_WPM

endif # !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN
    select LV_FONT_MONTSERRAT_26

endif # SHIELD_VISTA508
